{
    "name": "clean-code",
    "version": "2.0.0",
    "description": "Padrões pragmáticos de código limpo - direto, sem over-engineering e sem comentários desnecessários.",
    "priority": "critical",
    "triggers": {
        "filePatterns": [
            "*.ts",
            "*.tsx",
            "*.js",
            "*.jsx",
            "*.svelte",
            "*.py",
            "*.go",
            "*.rs",
            "*.java",
            "*.cs"
        ],
        "keywords": [
            "refatorar",
            "refactor",
            "clean code",
            "bug",
            "fix",
            "corrigir",
            "feature",
            "criar",
            "função",
            "componente"
        ]
    },
    "context": {
        "domain": "software-engineering",
        "principles": [
            "SRP",
            "DRY",
            "KISS",
            "YAGNI"
        ]
    },
    "executionMode": "auto"
}