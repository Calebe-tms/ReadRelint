{
    "name": "svelte-dashboard-architect",
    "version": "1.0.0",
    "description": "Aplica arquitetura headless, separação de temas e animações Svelte nativas.",
    "author": "Dashboard Team",
    "triggers": {
        "filePatterns": [
            "*.svelte",
            "*.ts",
            "*themes.css",
            "*global.css"
        ],
        "keywords": [
            "componente",
            "tema",
            "dashboard",
            "ui",
            "dark mode",
            "transição"
        ]
    },
    "context": {
        "framework": "svelte",
        "styling": "css-variables",
        "architecture": "headless-ui"
    },
    "executionMode": "auto"
}