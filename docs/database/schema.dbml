// =========================================================================
// SCHEMA READRELINT + INTELIGÊNCIA APP-AJ
// =========================================================================

// --- TABLE: relints ---
Table relints {
  id INTEGER [pk, increment]
  arquivo_origem TEXT [not null]
  numero_registro TEXT
  orgao_registro TEXT
  ano_registro TEXT
  assunto TEXT [not null]
  fato_principal TEXT
  data_fato TEXT
  hora_fato TEXT
  grupo_bm TEXT
  tipo_relint TEXT
  municipio TEXT
  bairro TEXT
  endereco TEXT
  unidade_policial TEXT
  coordenadas TEXT
  url_mapa TEXT
  resumo TEXT
  conteudo TEXT
  metodo_extracao TEXT [default: 'Ollama (IA)']
  editado_usuario INTEGER [default: 0]
}

// --- TABLE: relint_imagens ---
Table relint_imagens {
  id INTEGER [pk, increment]
  relint_id INTEGER [ref: > relints.id, not null]
  caminho_arquivo TEXT [not null]
  legenda TEXT
}

// =========================================================================
// ESPECIALIDADES POLIMÓRFICAS (Herdam de relints)
// =========================================================================

Table homicidio_detalhes {
  relint_id INTEGER [ref: > relints.id, pk]
  tipo_fato TEXT
  motivacao TEXT
}

Table prisao_trafico_detalhes {
  relint_id INTEGER [ref: > relints.id, pk]
  quantidade_drogas TEXT
  tipo_drogas TEXT
}

Table roubo_estabelecimento_detalhes {
  relint_id INTEGER [ref: > relints.id, pk]
  tipo_estabelecimento TEXT
  tipo_local TEXT
  vitimas_lesionadas INTEGER
  vitima_refem INTEGER
}

Table roubo_residencia_detalhes {
  relint_id INTEGER [ref: > relints.id, pk]
  tipo_local TEXT
  vitimas_lesionadas INTEGER
  vitima_refem INTEGER
}

Table roubo_veiculo_detalhes {
  relint_id INTEGER [ref: > relints.id, pk]
  modelo_veiculo TEXT
  placa TEXT
  recuperado INTEGER
  local_recuperacao TEXT
}

Table roubo_pedestre_detalhes {
  relint_id INTEGER [ref: > relints.id, pk]
  vitimas_lesionadas INTEGER
  arma_utilizada TEXT
  objeto_roubado TEXT
}

Table furto_veiculo_detalhes {
  relint_id INTEGER [ref: > relints.id, pk]
  modelo_veiculo TEXT
  placa TEXT
  recuperado INTEGER
  local_recuperacao TEXT
}

// =========================================================================
// INTELIGÊNCIA: PESSOAS (Relacionada com RELINTs e App-AJ)
// =========================================================================

Table pessoas {
  id INTEGER [pk, increment]
  chave_pessoa TEXT [unique, not null]
  nome TEXT [not null]
  alcunha TEXT
  documento TEXT
  foto_path TEXT
  antecedentes TEXT

  // DADOS ESPARSOS (Advindos do App-AJ e RELINTs complexos)
  dados_aj JSON // Armazena: Situacao, Presidio, Cela, Crimes, Companheiro, Tatuagens, Redes Sociais
}

Table relint_participantes {
  id INTEGER [pk, increment]
  relint_id INTEGER [ref: > relints.id, not null]
  pessoa_id INTEGER [ref: > pessoas.id, not null]
  tipo_participacao TEXT
  caminho_foto TEXT
}

// =========================================================================
// INTELIGÊNCIA: ENTIDADES COMPARTILHADAS E VÍNCULOS (App-AJ)
// =========================================================================

Table grupos_criminosos {
  id INTEGER [pk, increment]
  nome TEXT [not null]
  qrb TEXT
  observacao TEXT
}

Table grupos_familiares {
  id INTEGER [pk, increment]
  nome TEXT [not null]
  qrb TEXT
  observacao TEXT
}

Table veiculos {
  id INTEGER [pk, increment]
  placa TEXT [unique, not null]
  marca TEXT
  cor TEXT
  localizacao TEXT
  proprietario TEXT
  foto_path TEXT
  observacao TEXT
}

// Tabelas Pivot N:N
Table pessoa_grupo_criminoso {
  id INTEGER [pk, increment]
  pessoa_id INTEGER [ref: > pessoas.id]
  grupo_criminoso_id INTEGER [ref: > grupos_criminosos.id]
  funcao TEXT
}

Table pessoa_grupo_familiar {
  id INTEGER [pk, increment]
  pessoa_id INTEGER [ref: > pessoas.id]
  grupo_familiar_id INTEGER [ref: > grupos_familiares.id]
}

Table pessoa_veiculo {
  id INTEGER [pk, increment]
  pessoa_id INTEGER [ref: > pessoas.id]
  veiculo_id INTEGER [ref: > veiculos.id]
  tipo_posse TEXT
}
