// =========================================================================
// SCHEMA READRELINT + INTELIGÊNCIA APP-AJ
// =========================================================================

// --- TABLE: relints ---
Table relints {
  id INTEGER [pk, increment]
  arquivo_origem TEXT [not null]
  numero_registro TEXT
  orgao_registro TEXT
  ano_registro TEXT
  assunto TEXT [not null]
  fato_principal TEXT
  data_fato TEXT
  hora_fato TEXT
  grupo_bm TEXT
  tipo_relint TEXT
  municipio TEXT
  bairro TEXT
  endereco TEXT
  unidade_policial TEXT
  coordenadas TEXT
  url_mapa TEXT
  resumo TEXT
  conteudo TEXT
  metodo_extracao TEXT [default: 'Ollama (IA)']
  editado_usuario INTEGER [default: 0]
}

// --- TABLE: relint_imagens ---
Table relint_imagens {
  id INTEGER [pk, increment]
  relint_id INTEGER [ref: > relints.id, not null]
  caminho_arquivo TEXT [not null]
  legenda TEXT
}

// =========================================================================
// ESPECIALIDADES POLIMÓRFICAS (Herdam de relints)
// =========================================================================

Table homicidio_detalhes {
  relint_id INTEGER [ref: > relints.id, pk]
  tipo_fato TEXT
  motivacao TEXT
}

Table prisao_trafico_detalhes {
  relint_id INTEGER [ref: > relints.id, pk]
  quantidade_drogas TEXT
  tipo_drogas TEXT
}

Table roubo_estabelecimento_detalhes {
  relint_id INTEGER [ref: > relints.id, pk]
  tipo_estabelecimento TEXT
  tipo_local TEXT
  vitimas_lesionadas INTEGER
  vitima_refem INTEGER
}

Table roubo_residencia_detalhes {
  relint_id INTEGER [ref: > relints.id, pk]
  tipo_local TEXT
  vitimas_lesionadas INTEGER
  vitima_refem INTEGER
}

Table roubo_veiculo_detalhes {
  relint_id INTEGER [ref: > relints.id, pk]
  modelo_veiculo TEXT
  placa TEXT
  recuperado INTEGER
  local_recuperacao TEXT
}

Table roubo_pedestre_detalhes {
  relint_id INTEGER [ref: > relints.id, pk]
  vitimas_lesionadas INTEGER
  arma_utilizada TEXT
  objeto_roubado TEXT
}

Table furto_veiculo_detalhes {
  relint_id INTEGER [ref: > relints.id, pk]
  modelo_veiculo TEXT
  placa TEXT
  recuperado INTEGER
  local_recuperacao TEXT
}

// =========================================================================
// INTELIGÊNCIA: PESSOAS (Relacionada com RELINTs e App-AJ)
// =========================================================================

Table pessoas {
  id INTEGER [pk, increment]
  nome TEXT [not null]
  alcunha TEXT
  // Chave única (chave_pessoa foi eliminada, ver ADR-0101 — redundante com documento).
  // Sem RG/CPF real, guarda o nome em minúsculo como chave sintética (fallback).
  documento TEXT [unique, not null]
  antecedentes TEXT

  // DADOS ESPARSOS (Advindos do App-AJ e RELINTs complexos)
  // JSON livre, chave:valor sem schema fixo (ex: {"Situação": "Preso", "Presídio": "..."}).
  // Editável via formulário de pares chave/valor — usuário pode adicionar chaves novas
  // sem migração de banco. Ver ADR-0101.
  dados_aj JSON
}

// 1:N — substitui as colunas fixas Foto/Foto_2/Foto_3 da planilha App-AJ (ADR-0101)
Table pessoa_fotos {
  id INTEGER [pk, increment]
  pessoa_id INTEGER [ref: > pessoas.id, not null]
  caminho_arquivo TEXT [not null]
  ordem INTEGER
}

Table relint_participantes {
  id INTEGER [pk, increment]
  relint_id INTEGER [ref: > relints.id, not null]
  pessoa_id INTEGER [ref: > pessoas.id, not null]
  tipo_participacao TEXT
  caminho_foto TEXT
}

// =========================================================================
// INTELIGÊNCIA: ENTIDADES COMPARTILHADAS E VÍNCULOS (App-AJ)
// =========================================================================

// Locais nomeados (aba "QRB" da planilha App-AJ)
Table qrb {
  id INTEGER [pk, increment]
  chave_externa TEXT [unique, not null] // ID hash da planilha — importação idempotente
  nome_local TEXT [not null]
  municipio TEXT
  endereco TEXT
  coordenadas TEXT
  tipo_local TEXT // ex: "Moradia", "Propriedade Rural ligada ao Tráfico" — confirmado com dados reais
  foto TEXT
}

Table grupos_criminosos {
  id INTEGER [pk, increment]
  chave_externa TEXT [unique, not null] // ID hash da planilha
  nome TEXT [not null]
  qrb_id INTEGER [ref: > qrb.id]
  observacao TEXT
}

Table grupos_familiares {
  id INTEGER [pk, increment]
  chave_externa TEXT [unique, not null] // ID hash da planilha
  nome TEXT [not null]
  qrb_id INTEGER [ref: > qrb.id]
  observacao TEXT
}

Table veiculos {
  id INTEGER [pk, increment]
  placa TEXT [unique, not null]
  marca TEXT
  cor TEXT
  localizacao TEXT
  proprietario TEXT
  foto_path TEXT
  observacao TEXT
}

// Tabelas Pivot N:N
// pessoa_grupo_criminoso: formato confirmado com dados reais da planilha — ID, Criminoso (RG),
// Grupo Criminoso (hash), Função (texto livre: "Chefe", "Motorista", "Distribuidor" etc, sem
// enum fechado). pessoa_grupo_familiar padronizada com a mesma coluna `funcao` por consistência
// de schema, mesmo a aba de origem (R_GRUPO_FAMILIAR) não tendo esse dado — fica NULL na
// migração inicial, preenchível depois via CRUD do dashboard.
Table pessoa_grupo_criminoso {
  id INTEGER [pk, increment]
  pessoa_id INTEGER [ref: > pessoas.id]
  grupo_criminoso_id INTEGER [ref: > grupos_criminosos.id]
  funcao TEXT
}

Table pessoa_grupo_familiar {
  id INTEGER [pk, increment]
  pessoa_id INTEGER [ref: > pessoas.id]
  grupo_familiar_id INTEGER [ref: > grupos_familiares.id]
  funcao TEXT
}

Table pessoa_qrb {
  id INTEGER [pk, increment]
  pessoa_id INTEGER [ref: > pessoas.id]
  qrb_id INTEGER [ref: > qrb.id]
}

// VEICULOS_POSSE real: ID, Veículo (placa), Posse (RG da pessoa — é a própria chave de vínculo,
// não um campo descritivo), Data. Sem coluna de "tipo de posse".
Table pessoa_veiculo {
  id INTEGER [pk, increment]
  pessoa_id INTEGER [ref: > pessoas.id]
  veiculo_id INTEGER [ref: > veiculos.id]
  data_posse TEXT
}
